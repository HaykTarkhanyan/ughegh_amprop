# script logs (logs/<script>.log) and any other log files
logs/
*.log
# LaTeX build output (aux files, draft PDFs); decks build into <deck>/build/
build/
# secrets, if an API key is ever used
.env
__pycache__/
# Git Bash crash dumps
*.stackdump

# Node projects (03_shorts bake-off)
node_modules/
# rendered videos and previews (regenerated from code)
03_shorts/**/out/

# bake-off: copies made by 03_shorts/bakeoff/sync_assets.py
03_shorts/bakeoff/remotion/public/
03_shorts/bakeoff/remotion/src/data.json
03_shorts/bakeoff/hyperframes/assets/
03_shorts/*/build/
03_shorts/bakeoff/hyperframes/.hyperframes/
03_shorts/bakeoff/hyperframes/renders/

# render project: synced inputs (regenerated by render/sync_short.py)
03_shorts/render/src/data/
03_shorts/render/public/*/narration.wav
03_shorts/zero_knowledge/audio/*.wav
